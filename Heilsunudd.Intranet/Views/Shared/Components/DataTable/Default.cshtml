@model Heilsunudd.Intranet.Views.Shared.Components.DataTableViewModel



<div class="overflow-x-auto bg-white rounded-xl shadow-lg p-6">
    <div class="flex justify-between items-center mb-4">
        <h2 class="text-2xl font-bold">@Model.Title</h2>
        <div class="flex gap-2">
            <a href="/@Model.Title/Create" class="btn btn-dash btn-accent">
                <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="currentColor">
                    <path d="M440-280h80v-160h160v-80H520v-160h-80v160H280v80h160v160Zm40 200q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/>
                </svg>
                Add New
            </a>
        </div>
    </div>
    
    <table class="table table-zebra">
        <thead>
        <tr>
            @foreach (var prop in Model.Properties)
            {
                <th>
                    @foreach (var word in @prop.DisplayName.Split())
                    {
                        @word<br/>
                    }
                </th>
            }
                <th class="w-32">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Data)
        {
            <tr class="hover">
                @foreach (var prop in Model.Properties)
                {
                    <td>
                        @{
                            var value = prop.Property.GetValue(item);
                            if (value != null)
                            {
                                switch (value)
                                {
                                    case DateTime dateValue:
                                        @dateValue.ToString("MM/dd/yyyy")
                                        break;
                                    case bool boolValue:
                                        <span class="badge @(boolValue ? "badge-success" : "badge-error")">
                                            @(boolValue ? "Yes" : "No")
                                        </span>
                                        break;
                                    case string longStringValue:
                                        if (longStringValue.Length > 14)
                                        {
                                            <div data-modal-target="@longStringValue" data-modal-toggle="@longStringValue" class="" type="button">
                                                @longStringValue[..15]...
                                            </div>
                                            
                                            
                                            <div id="@longStringValue" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
                                                <div class="relative p-4 w-full max-w-2xl max-h-full">
                                                    <div class="relative bg-white rounded-lg shadow-sm dark:bg-gray-700 min-w-1/2">
                                                        <div class="flex items-center justify-between p-2 md:p-5 rounded-t dark:border-gray-600 border-gray-200">
                                            
                                                            <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-3 h-3 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-hide="@longStringValue">
                                                                <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                                                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                                                                </svg>
                                                            </button>
                                                        </div>
                                            
                                                        <div class="p-4 md:p-5 space-y-4">
                                                            <p class="text-base leading-relaxed text-gray-500 dark:text-gray-400 text-wrap">
                                                                @longStringValue
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            @longStringValue
                                        }
                                        break;
                                    default:
                                        @value
                                        break;
                                }
                            }
                            else
                            {
                                <span class="text-gray-400 italic">N/A</span>
                            }
                        }
                    </td>
                }
                <td>
                        @{
                            var idItem = item.GetType().GetProperty("Id" + Model.Title)?.GetValue(item);
                        }
                        <div class="join">
                            <button class="btn btn-sm btn-ghost join-item" title="Edit">
                                <a href="/@Model.Title/Edit/@idItem">
                                    <svg xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor">
                                        <path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"/>
                                    </svg>
                                    </a>
                            </button>
                        
                            <form asp-action="Delete" method="post">
                                    <input type="hidden" value="@idItem" name="id" />
                                <button type="submit" class="btn btn-sm btn-ghost join-item text-error" title="Delete">
                                    <svg xmlns="http://www.w3.org/2000/svg" height="16px" viewBox="0 -960 960 960" width="16px" fill="currentColor">
                                        <path d="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"/>
                                    </svg>
                                </button>
                            </form>
                        </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    
</div>