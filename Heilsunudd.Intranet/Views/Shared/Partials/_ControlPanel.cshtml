@model object
@{
    var title = ViewData["PanelTitle"] as string ?? "Control Panel";
    var createButtonText = ViewData["CreateButtonText"] as string ?? "Create New";
}

<div class="relative z-0 flex flex-col gap-4 p-10 bg-white border-2 border-gray-600 rounded-md border-dashed [&>*]:mb-5 w-1/4 mx-auto">
    <h1 class="text-center text-lg p-4 border-3 border-black bg-white text-black absolute z-10 rounded-2xl -top-10 left-35">@title</h1>

    <p class="relative z-0 mt-5 text-center text-md rounded-lg bg-black text-white p-2 w-1/2 mb-5 hover:shadow-2xl hover:text-black hover:bg-white transition duration-300 ease-in-out border-2">
        <a asp-action="Create">@createButtonText</a>
    </p>
    
    @if (Model is IEnumerable<object> enumerable)
    {
        <partial name="Partials/_GenericTable" model="enumerable" />
    }
    else
    {
        @Model
    }
</div>