@model object
@{
    var idProp = Model.GetType().GetProperties().FirstOrDefault(p => p.Name.EndsWith("Id") || p.Name == "Id");
    var idValue = idProp != null ? idProp.GetValue(Model) : null;
}

<td class="flex flex-row justify-center items-center gap-2 [&>*]:my-2">
    <a class="py-1 px-3 border-2 border-dashed border-gray-600 rounded-md hover:bg-black hover:text-white hover:scale-95 cursor-pointer transition duration-300 ease-in-out hover:border-0 hover:-translate-y-2" 
       asp-action="Edit" 
       asp-route-id="@idValue">Edit</a>
    <a class="py-1 px-3 border-2 border-dashed border-gray-600 rounded-md hover:bg-black hover:text-white hover:scale-95 cursor-pointer transition duration-300 ease-in-out hover:border-0 hover:-translate-y-2" 
       asp-action="Details" 
       asp-route-id="@idValue">Details</a>
    <a class="py-1 px-3 border-2 border-dashed border-gray-600 rounded-md hover:bg-black hover:text-white hover:scale-95 cursor-pointer transition duration-300 ease-in-out hover:border-0 hover:-translate-y-2" 
       asp-action="Delete" 
       asp-route-id="@idValue">Delete</a>
</td>