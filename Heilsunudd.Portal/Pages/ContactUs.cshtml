@page
@model Heilsunudd.Pages.ContactUs

@{
    ViewData["Title"] = "Contact us";
}

<section
    id="ContactUs"
    class="flex flex-col items-center justify-between mx-auto gap-10 h-3/5 w-full"
>
    <div class="flex flex-row items-center justify-center gap-4 text-black">
        <span class="text-lg font-inika">●</span>
        <h1 class="text-4xl font-inika">Contact</h1>
        <span class="text-lg font-inika">●</span>
    </div>
    <div class="flex flex-row justify-between gap-50 max-h-full m-auto" id="intro">
        <div class="m-auto">
            <div class="rounded-lg bg-gray-100 p-7 flex flex-col justify-evenly gap-5 h-auto outline-3 outline-offset-5 outline-dotted outline-white w-full" id="textCard">
                <form method="POST" asp-page-handler="CustomMessage" hx-boost="true" hx-target="#afterMessageHr" hx-swap="afterend">
                    <h3 class="text-xl">Contact us</h3>
                    <div class="flex flex-col gap-5 mt-4">
                        <div>
                            <label for="contactFormSelect" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Select an inquiry</label>
                            <select id="contactFormSelect" class="bg-gray-50 border-2 border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                                <option value="generalInquiry" selected>General inquiry</option>
                                <option value="deleteBooking">Delete a booking</option>
                            </select>
                        </div>
                        <input type="number" id="idBooking" name="idBooking" placeholder="Booking Id" class="hidden p-2 border-2 border-gray-300 rounded-md"/>
                        <input type="text" name="name" placeholder="Name" required class="p-2 border-2 border-gray-300 rounded-md"/>
                        <input type="email" name="email" placeholder="Email" required class="p-2 border-2 border-gray-300 rounded-md"/>
                        <textarea name="message" placeholder="Message" required class="p-2 border-2 border-gray-300 rounded-md"></textarea>
                        <hr id="afterMessageHr" class="my-4 border-gray-300"/>
                        <button type="submit" class="border-2 border-black rounded-lg py-3 px-10 cursor-pointer transition duration-300 ease-in-out hover:-translate-y-2 active:bg-black active:text-white active:scale-95 active:outline-2 active:outline-dotted active:outline-offset-2 font-inika">Send</button>
                    </div>
                </form>
            </div>
        </div>
        <img class="opacity-75 outline-2 outline-offset-3 outline-solid rounded-xl" src="public/im-card.jpg" alt="massage parlour equipment"/>
    </div>
</section>

<script>
    document.getElementById("contactFormSelect").addEventListener("change", function() {
        if (this.value === "deleteBooking") {
            document.getElementById("idBooking").classList.remove("hidden");
            document.getElementById("idBooking").setAttribute("required");
        } else {
            document.getElementById("idBooking").classList.add("hidden");
            document.getElementById("idBooking").removeAttribute("required");
        }
    });
</script>