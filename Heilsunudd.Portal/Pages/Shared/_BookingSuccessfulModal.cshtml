@model Heilsunudd.Data.Data.Bookings.Booking

<div id="crud-modal" tabindex="-1"  style="background-color: rgba(255, 255, 255, 0.4);
  -webkit-backdrop-filter: blur(5px);
  backdrop-filter: blur(5px); padding: 4rem;"  class="p-4 overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full backdrop-blur-xs">
    <div class="relative p-4 w-full max-w-md max-h-full ">
        <!-- Modal content -->
        <div class="relative bg-white rounded-lg shadow-sm dark:bg-gray-700">
            <!-- Modal header -->
                <div class="flex flex-row justify-between items-center w-full border-b-2 border-black p-4 bg-white">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                        Booking Successful
                    </h3>
                    <button
                        id="modalCloseBtn" type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-toggle="crud-modal">
                        <a asp-page="/Bookings">
                            <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                            </svg>
                            <span class="sr-only">Close modal</span>
                        </a>
                    </button>
                </div>
            
            <dl class="max-w-md text-gray-900 divide-y divide-gray-200 dark:text-white dark:divide-gray-700 p-4 bg-gray-100">
                <div class="flex flex-col pt-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">Booking Id : </dt>
                    <dd class="text-lg font-semibold">@Model.IdBooking</dd>
                </div>
                <div class="flex flex-col pb-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">Booked date : </dt>
                    <dd class="text-lg font-semibold">@Model.BookingDate</dd>
                </div>
                <div class="flex flex-col py-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">Booked time : </dt>
                    <dd class="text-lg font-semibold">@Model.BookingTime</dd>
                </div>
                <div class="flex flex-col pt-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">At location:</dt>
                    <dd class="text-lg font-semibold">@Model.Location?.LocationName</dd>
                </div>
                <div class="flex flex-col pb-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">Booked service : </dt>
                    <dd class="text-lg font-semibold">@Model.Service?.ServiceName</dd>
                </div>
                <div class="flex flex-col py-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">Price : </dt>
                    <dd class="text-lg font-semibold">@Model.Service?.ServicePrice</dd>
                </div>
                <div class="flex flex-col pt-3">
                    <dt class="mb-1 text-gray-500 md:text-lg dark:text-gray-400">Name on the booking : </dt>
                    <dd class="text-lg font-semibold">@Model.FirstName @Model.LastName</dd>
                </div>
                <div class="flex flex-col pt-3 gap-4">
                    <p>
                        Please confirm your booking by clicking the link sent to email : @Model.Email
                    </p>
                    <p>
                        You can pay upfront or pay on arrival. In case you decide to prepay we have included a payment link in the email.
                    </p>
                </div>
            </dl>

            
        </div>
    </div>
</div> 

<script>

    document.addEventListener('click', function(e) {

            const modal = e.target.closest('[id^="crud-modal"]') || document.querySelector('.crud-modal-active');
        if (e.target.closest('#modalCloseBtn')) {
            if (modal) {
                modal.remove();
            }
        }
    });

    document.addEventListener('submit', function(e) {
        const submitBtn = e.target.getElementById("submitBookingBtn");
        if (submitBtn) {
            submitBtn.disabled = true;
            setTimeout(() => {
                submitBtn.disabled = false;
            }, 3000);
        }
    });
</script>