@using System.Globalization
@model (Heilsunudd.Data.Data.Bookings.Location, Heilsunudd.Data.Data.Bookings.Service, List<Heilsunudd.Data.Data.Bookings.Calendar>)

@{
   var dateNow = DateTime.Now.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture);

   var idService = Model.Item2.IdService;
   var sampleDateFromBackEnd = Model.Item3.FirstOrDefault()?.StartTime.Date.ToShortDateString();
   var idLocation = Model.Item1.IdLocation;
   var allSlots = new List<string>()
   {
       "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00", "18:00"
   };
}

<div id="BookingsCardContainer" class="flex flex-row m-2 gap-3 items-start justify-evenly">
    
    @* Datepicker *@
    <div class="flex flex-col gap-2">
        <div id="datepicker-inline" data-date="" style="outline-offset: 0.1rem; outline-width: 0.15rem;" class="outline-4 outline-dotted outline-offset-4 outline-white shadow-md rounded-md"></div>

        <div class="flex flex-row w-full items-center justify-between mt-6">
            <button id="datepicker-button-today" name="Today" class="text-xl shadow-xl border-4 border-white border-dotted rounded-lg py-3 px-10 cursor-pointer transition duration-300 ease-in-out hover:-translate-y-2 hover:border-[#D2DCE5] active:bg-black active:text-white active:scale-95">Today</button>
            <button onclick="" id="datepicker-button-clear" name="Clear" class="text-xl shadow-xl border-4 border-white rounded-lg py-3 px-10 cursor-pointer transition duration-300 ease-in-out hover:-translate-y-2 hover:border-[#D2DCE5] active:bg-black active:text-white active:scale-95">Clear</button>
        </div>
    </div>
    @* End of datepicker *@

    <div class="flex flex-col items-start justify-evenly">

        <button
            hx-target="#BookingsCard"
            hx-swap="beforeend"
            hx-get="?handler=BookingModal"
            hx-vals='js:{
        "idLocation": @idLocation,
        "idService": @idService,
        "selectedDate": document.getElementById("modalDate").value, 
        "selectedTimeslot": document.getElementById("modalTimeSlot").value
    }'
            hx-trigger="click"
            id="modalBtn" type="button" class="inline-flex items-center w-full py-2 px-5 me-2 justify-center text-lg font-medium text-gray-900 focus:outline-none shadow-xl border-4 border-white rounded-lg cursor-pointer transition duration-300 ease-in-out hover:-translate-y-2 hover:border-[#D2DCE5] active:bg-black active:text-white active:scale-95">
            <svg class="w-4 h-4 text-gray-800 dark:text-white me-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10S2 17.523 2 12Zm11-4a1 1 0 1 0-2 0v4a1 1 0 0 0 .293.707l3 3a1 1 0 0 0 1.414-1.414L13 11.586V8Z" clip-rule="evenodd"/>
            </svg>
            <input hidden="hidden" type="text" name="date" id="modalDate" value="@dateNow"/>
            <input hidden="hidden" type="text" name="date" id="modalTimeSlot" value=""/>

            Confirm time slot
        </button>

        <ul id="timetable" class="grid w-full grid-cols-2 gap-2 mt-5">

            @foreach (var slot in allSlots)
            {
                <li>
                    <input onclick="handleChooseTimeslotOnMount('@slot')" type="radio" id="@slot" value="@slot" class="hidden peer" name="timetable">
                    <label for="@slot"
                           style="outline: dotted; outline-offset: 0.1rem;"
                           class="shadow-lg inline-flex items-center justify-center w-full p-1 font-medium text-center text-md bg-white  rounded-lg cursor-pointer text-black   peer-checked:border-white peer-checked:bg-blue-600 peer-checked:text-white transition duration-300 ease-in-out hover:-translate-y-2 ">
                        @slot
                    </label>
                </li>
            }

        </ul>
    </div>
</div>

<script>
    function handleChooseTimeslotOnMount(slot) {
        document.getElementById("modalTimeSlot").setAttribute("value", slot);
        document.getElementById("modalDate").setAttribute("value", todayString);
        console.log("handlechoosetimeslotonmount: ",document.getElementById("modalTimeSlot").getAttribute("value").valueOf());
        console.log("handlechoosetimeslotonmount: ",document.getElementById("modalDate").getAttribute("value").valueOf());
        
    }

    // (function() {
    const datepicker = document.getElementById('datepicker-inline');
    const datePickerBtnToday = document.getElementById('datepicker-button-today');
    const datePickerBtnClear = document.getElementById('datepicker-button-clear');
    const todayString = new Date().toLocaleDateString('de-DE');
    let selectedDate = datepicker.getAttribute('data-date');
    
    let datepickerInstance = null;

    if (datepicker && typeof Datepicker !== 'undefined') {
        datepicker.setAttribute('data-date', todayString);
        
        datepickerInstance = new Datepicker(datepicker, {
            format: 'dd.mm.yyyy',
            // buttony ponizej nie dzialaja w partialach stad customowe buttony.
            todayBtn: false,
            clearBtn: false,
            inline: true,
            
        });

        datepicker.addEventListener('changeDate', function(event) {
            if (event.detail.date) {
                datepicker.setAttribute('data-date', event.detail.date);
                selectedDate = new Date(event.detail.date).toLocaleDateString('de-DE', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric'
                });
                console.log(selectedDate);
                
                document.getElementById('modalDate').setAttribute("value", selectedDate);
                document.getElementById("modalTimeSlot").setAttribute("value", "");

                const url = `?handler=Timeslots&IdLocation=${@idLocation}&selectedDate=${selectedDate}`;

                htmx.ajax('GET', url, {
                    target: '#timetable',
                    swap: 'innerHTML'
                });
                
                console.log(url);
            }
        });
    }
    

    if (datePickerBtnToday && datepicker) {
        datePickerBtnToday.addEventListener('click', function() {
            
            datepicker.setAttribute('data-date', todayString);
            
            if (datepickerInstance) {
                datepickerInstance.destroy();
            }
            datepickerInstance = new Datepicker(datepicker, {
                autohide: true,
                format: 'dd.mm.yyyy',
                todayBtn: false,
                clearBtn: false,
                inline: true
            });

            document.getElementById('modalDate').setAttribute("value", todayString);
            document.getElementById("modalTimeSlot").setAttribute("value", "");

            datepicker.addEventListener('changeDate', function(event) {
                if (event.detail.date) {
                    datepicker.setAttribute('data-date', event.detail.date);
                    selectedDate = new Date(event.detail.date).toLocaleDateString('de-DE', {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric'
                    });
                    console.log(selectedDate);

                    

                    const url = `?handler=Timeslots&IdLocation=${@idLocation}&selectedDate=${selectedDate}`;

                    htmx.ajax('GET', url, {
                        target: '#timetable',
                        swap: 'innerHTML'
                    });
                }
            });
            
        });
    }
    
    if (datePickerBtnClear && datepicker) {
        datePickerBtnClear.addEventListener('click', function() {
            datepicker.removeAttribute('data-date');

            if (datepickerInstance) {
                datepickerInstance.destroy();
            }
            datepickerInstance = new Datepicker(datepicker, {
                autohide: true,
                format: 'dd.mm.yyyy',
                todayBtn: false,
                clearBtn: false,
                inline: true,
            });

            document.getElementById('modalDate').setAttribute("value", "");



            datepicker.addEventListener('changeDate', function(event) {
                if (event.detail.date) {
                    datepicker.setAttribute('data-date', event.detail.date);
                    selectedDate = new Date(event.detail.date).toLocaleDateString('de-DE', {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric'
                    });
                    console.log(selectedDate);

                    document.getElementById('modalDate').setAttribute("value", selectedDate);
                    document.getElementById("modalTimeSlot").setAttribute("value", "");

                    const url = `?handler=Timeslots&IdLocation=${@idLocation}&selectedDate=${selectedDate}`;

                    htmx.ajax('GET', url, {
                        target: '#timetable',
                        swap: 'innerHTML'
                    });
                }
            });
        });
    }
    
