<script>
   (function() {
       const datepicker = document.getElementById('datepicker-inline');
       if (datepicker && typeof Datepicker !== 'undefined') {
           new Datepicker(datepicker, {
               autohide: true,
               format: 'mm/dd/yyyy'
           });
       }
       
       const collapseButton = document.querySelector('[data-collapse-toggle="timetable"]');
       const timetable = document.getElementById('timetable');
       if (collapseButton && timetable && typeof Collapse !== 'undefined') {
           new Collapse(timetable, {
               triggerEl: collapseButton
           });
       }
   })();
</script>