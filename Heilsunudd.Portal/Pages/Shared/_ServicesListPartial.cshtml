@model Heilsunudd.Data.Data.Bookings.Location

@{
    var IdLocation = Model.IdLocation;
    var services = Model.Services;
}



@if (services.Count < 1)
{
    <p>No services available at this location</p>
}
else
{
    @foreach (var service in services)
    {
        
        <div role="button" id="service-@service.IdService" class="flex flex-row items-center justify-between bg-gray-200 rounded-md p-3 gap-4 hover:bg-[#C1C1C1] hover:text-black hover:scale-99 transition-all duration-300 ease-in"
             hx-target="#BookingsCardContainer"
             hx-swap="innerHTML"
             hx-get="/Bookings?handler=Calendar&IdLocation=@IdLocation&IdService=@service.IdService">
            <div class="flex flex-row items-center justify-start gap-10">
                <span title="ServiceIcon" class="max-w-1/20 px-4 py-2 text-2xl rounded-md bg-gray-100">@service.ServiceName[..1]</span>
                <div id="BookingsCardServiceListDetails-@service.IdService" class="flex flex-col gap-3">
                    <h3 title="ServiceName" class="text-lg">@service.ServiceName</h3>
                    <div title="ServiceDetails" class="flex flex-row items-start gap-2">
                        <p>@service.ServiceDuration</p>
                        <span>*</span>
                        <p>@service.ServicePrice kr.</p>
                    </div>
                    <p title="ServiceDescription">
                        @service.ServiceDescription
                    </p>
                </div>
            </div>
            <button>
                <span title="ServiceChevron" class="text-2xl">></span>
            </button>
        </div>
    }
    
}