@model Heilsunudd.Data.Data.CMS.BlogPost

@{
   var post = Model;
   var tags = string.IsNullOrEmpty(post.Tags) ? [] : post.Tags.Split(",");
}

            <div class="grid grid-cols-3 gap-4 mb-4">
               <div class="flex items-center justify-center h-24 rounded-sm bg-gray-50 dark:bg-gray-800">
                  <h1 id="blogPostCategory">@post.BlogCategory?.CategoryName</h1>
               </div>
               <div class="flex items-center justify-center h-24 rounded-sm bg-gray-50 dark:bg-gray-800">
                  <p id="blogPostTitle" class="text-2xl text-gray-400 dark:text-gray-500 px-4 flex text-center">
                     @post.Title
                  </p>
               </div>
               <ul id="blogPostTagList" class="flex flex-row items-center justify-center h-24 rounded-sm bg-gray-50 dark:bg-gray-800 flex-wrap">
                  @foreach (var tag in tags)
                  {
                     <li>#@tag</li>
                     <span>&nbsp;&nbsp; </span>
                  }
               </ul>
            </div>
            <div class="flex flex-col py-4 px-4 items-center justify-center max-h-fit mb-4 rounded-sm bg-gray-50 dark:bg-gray-800 gap-2">
               <p class="mb-3 text-lg text-gray-500 md:text-xl dark:text-gray-400">@post.Content</p>
