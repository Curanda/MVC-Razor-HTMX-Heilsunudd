@page
@model AboutUsModel
@{
    ViewData["Title"] = "About Us";
    var aboutUsItems = Model.AboutUsItems;
}

    <section
        id="AboutUs"
        class="flex flex-col items-center justify-start mx-auto gap-10 h-3/5 w-3/5">
        
        <div class="flex flex-row items-center justify-center gap-4 text-black">
            <span class="text-lg font-inika">●</span>
            <h1 class="text-4xl font-inika">About us</h1>
            <span class="text-lg font-inika">●</span>
        </div>
        <div class="flex flex-col gap-4">
            @{
                var index = 1;
            }
            @foreach (var item in aboutUsItems)
            {
                if (index % 2 != 0)
                {
                    <div itemid="@item.IdAboutUs" class="flex flex-row justify-between gap-50 max-h-4/5 m-auto pb-4">
                        <div class="m-auto">
                            <div class="rounded-lg bg-gray-100 p-7 flex flex-col justify-evenly gap-5 h-auto outline-3 outline-offset-5 outline-dotted outline-white" id="textCard">
                                <h3 class="text-xl">@item.Title</h3>
                                <p>@item.Content</p>
                            </div>
                        </div>
                        <img class="opacity-75 outline-2 outline-offset-3 outline-solid rounded-xl" src="@item.ImageUrl" alt="@item.IdAboutUs"/>
                    </div>
                }
                else
                {
                    <div itemid="@item.IdAboutUs" class="flex flex-row justify-between gap-50 max-h-4/5 m-auto pb-4">
                        <img class="opacity-75 outline-2 outline-offset-3 outline-solid rounded-xl" src="@item.ImageUrl" alt="@item.IdAboutUs"/>
                        <div class="m-auto">
                            <div class="rounded-lg bg-gray-100 p-7 flex flex-col justify-evenly gap-5 h-auto outline-3 outline-offset-5 outline-dotted outline-white" id="textCard">
                                <h3 class="text-xl">@item.Title</h3>
                                <p>@item.Content</p>
                            </div>
                        </div>
                    </div>
                }
                index++;
            }
        </div>
    </section>
